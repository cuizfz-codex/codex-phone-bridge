# Minimal trusted TLS template for Start-Phone-Codex.command
# Copy this file to launcher.env, then fill the two certificate paths.

PORT=8787
BIND_HOST=0.0.0.0
REMOTE_MODE=tailscale

HTTPS_ENABLED=1
TLS_MODE=custom

# Required: use a trusted cert/key pair to avoid browser security warnings.
TLS_CERT_FILE=/absolute/path/to/fullchain.pem
TLS_KEY_FILE=/absolute/path/to/privkey.pem

# Optional
TLS_CA_FILE=
HTTPS_REDIRECT_PORT=0

# Access control (optional)
REQUIRE_LOGIN=0
SIMPLE_LOGIN_PASSWORD=
