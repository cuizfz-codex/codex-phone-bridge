CODEX_APP_SERVER_WS_URL=
CODEX_APP_SERVER_WS_SPAWN=1
CODEX_WS_PROXY_LISTEN_PORT=18791
CODEX_WS_PROXY_SPAWN_UPSTREAM=1
MEDIA_ROOT=./data/media
MEDIA_INDEX=./data/media/index.json
THREAD_LIST_POLL_MS=8000
THREAD_READ_POLL_ACTIVE_MS=2000
THREAD_READ_POLL_IDLE_MS=10000
DEFAULT_APPROVAL_POLICY=never
DEFAULT_SANDBOX_POLICY=danger-full-access
AUTO_APPROVAL_MODE=acceptForSession
MAX_IMAGE_MB=12
MAX_VOICE_MB=25
DESKTOP_NUDGE_MODE=frontmost
DESKTOP_NUDGE_THROTTLE_MS=2000
DESKTOP_NUDGE_HELPER_APP=
HTTPS_ENABLED=1
