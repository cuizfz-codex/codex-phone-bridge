# Optional overrides for Start-Phone-Codex.command
# Copy this file to launcher.env and edit values as needed.

# Service listen port
PORT=8787

# 0.0.0.0 = LAN/mobile access, 127.0.0.1 = local only
BIND_HOST=0.0.0.0

# 0 = no login page, 1 = enable simple password login
REQUIRE_LOGIN=0

# Required only when REQUIRE_LOGIN=1
SIMPLE_LOGIN_PASSWORD=change_me

# Keep this as 1 to auto-spawn codex app-server when needed
CODEX_APP_SERVER_WS_SPAWN=1

# off | tailscale
REMOTE_MODE=tailscale

# HTTPS is mandatory for secure mobile web access
HTTPS_ENABLED=1

# Optional http->https redirect port (0 = disable redirect listener)
HTTPS_REDIRECT_PORT=0

# TLS cert strategy: auto | custom | tailscale | self-signed
TLS_MODE=auto

# Optional explicit hostname used when issuing tailscale cert
TLS_HOSTNAME=

# Use these in TLS_MODE=custom (absolute paths recommended)
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=

# Set to 1 only when using self-signed cert (local verification checks skip cert validation)
TLS_INSECURE_SKIP_VERIFY=0
